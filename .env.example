# Required: replace these placeholders with your resource endpoint and deployment name.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME

# Workload: offer 45,000 input tokens against a 30,000-TPM allocation.
TPM_QUOTA_TPM=30000
TPM_TARGET_TOKENS=45000
TPM_DURATION_SECONDS=60
TPM_INPUT_TOKENS=2000
TPM_MAX_OUTPUT_TOKENS=64
TPM_CONCURRENCY=4

# Safety and model settings.
TPM_TIMEOUT_SECONDS=60
TPM_MAX_REQUESTS=1000
TPM_ENCODING=o200k_base
TPM_OUTPUT_TOKEN_PARAMETER=max_completion_tokens

# Microsoft Entra ID: run az login locally. No API key is required.
TPM_TOKEN_SCOPE=https://ai.azure.com/.default
